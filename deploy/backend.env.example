# ==============================================================================
# Kuwait Painters Platform - AWS Production Backend Environment Variables
# Copy this file to 'backend.env' and populate with production secrets:
#   cp backend.env.example backend.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
TZ=Asia/Kuwait
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# These match the docker-compose postgres container parameters.
# ------------------------------------------------------------------------------
POSTGRES_USER=kuwait_admin
# Replace with a strong random password generated via: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_password_minimum_24_chars
POSTGRES_DB=kuwait_painters
POSTGRES_PORT=5432

# Drizzle / PG connection string pointing to internal docker network host 'postgres'
DATABASE_URL=postgresql://kuwait_admin:replace_with_strong_password_minimum_24_chars@postgres:5432/kuwait_painters?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# Generate high-entropy secrets using: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_64_character_hex_secret_from_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_64_character_random_hex_string

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated)
# Include your Cloudflare Pages preview & production domains and custom domain.
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://sabbagh-kuwait.pages.dev,https://kuwaitpainters.com,https://www.kuwaitpainters.com

# ------------------------------------------------------------------------------
# 5. Rate Limiting Parameters (in-memory Express fallback)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ------------------------------------------------------------------------------
# 6. Storage / S3 Attachments (Optional for future receipt/photo uploads)
# ------------------------------------------------------------------------------
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=kuwait-painters-uploads
