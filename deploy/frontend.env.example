# ==============================================================================
# Kuwait Painters Platform - Frontend Environment Variables (Cloudflare Pages)
# ==============================================================================
#
# INSTRUCTIONS FOR CLOUDFLARE PAGES:
# 1. In your Cloudflare Dashboard, go to Workers & Pages > sabbagh-kuwait.
# 2. Navigate to Settings > Environment variables.
# 3. Add the following variable for both Production and Preview environments:
#
#    Variable Name: VITE_API_URL
#    Value: https://api.yourdomain.com/api (or your AWS EC2/Lightsail endpoint)
#
# FOR LOCAL DEVELOPMENT:
# Copy this file to 'artifacts/sabbagh-kuwait/.env.local' and set:
#    VITE_API_URL=http://localhost:5000/api
# ==============================================================================

# Backend API endpoint URL (including /api path prefix)
VITE_API_URL=https://api.yourdomain.com/api

# Optional: Google Analytics / Tag Manager ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
